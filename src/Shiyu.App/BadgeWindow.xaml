<Window x:Class="Shiyu.App.BadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False" Opacity="0"
        AutomationProperties.Name="翻译这段选中的文字"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
    <!-- 圆角方形徽标（§4.7，票 20；用户需求 2026-10-10：只留一个「译」，"翻译这段"四个字
         去掉；2026-10-13：圆形换成圆角方形）：32 见方（Control.Height）、圆角 Radius.Overlay=8，
         与浮层窗口同一个圆角。说明退到悬停提示与无障碍名里，和应用里别的纯图标按钮一样。
         12 DIP 透明边距让 Shadow.Badge 完整——淡出靠动画整窗 Opacity，窗口得是透明分层窗，
         DWM 阴影挂不上，徽标是浮层家族里唯一由 WPF 画阴影的窗。窗口按含边距的尺寸定位，
         光标旁的落点不受影响。 -->
    <Border x:Name="Tile" CornerRadius="{DynamicResource Radius.Overlay}" Cursor="Hand"
            Width="{DynamicResource Control.Height}" Height="{DynamicResource Control.Height}" Margin="12"
            Background="{DynamicResource Brush.AccentFloating}" MouseLeftButtonUp="OnClicked"
            ToolTip="翻译这段选中的文字">
        <Border.Effect>
            <StaticResource ResourceKey="Shadow.Badge"/>
        </Border.Effect>
        <TextBlock x:Name="Glyph" Text="译" Foreground="{DynamicResource Brush.TextOnAccent}"
                   FontSize="{DynamicResource Type.Body}"
                   FontWeight="{DynamicResource Weight.Emphasis}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
</Window>
