<Window x:Class="Shiyu.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Shiyu.App"
        Title="拾语 · 设置" Width="880" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.FontSize="{DynamicResource Type.Body}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        PreviewKeyDown="OnWindowKeyDown"
        PreviewKeyUp="OnWindowKeyUp">
    <!--
      票 23 / ADR-0012 §7：常规窗走系统窗框——SingleBorderWindow + 客户区
      透明（code-behind 把 CompositionTarget.BackgroundColor 置透明，票 19
      spike 配方），DWM 在底下画 Mica，标题栏、圆角、阴影、贴靠布局都是
      系统的。旧配方（分层窗口 + 自绘壳）整体退役。
    -->
    <!--
      根底 = SurfaceMaterial（与库窗同款，视觉走查 2026-10-03）：裸区
      不再单独指望 DWM Mica——材质未实际渲染时这层 94% 不透明的主题淡
      染兜底，暗色主题下正文不再透出桌面亮底。
    -->
    <Grid Background="{DynamicResource Brush.SurfaceMaterial}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="240" MinWidth="48"/>
            <ColumnDefinition x:Name="ContentColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左导航（§6.3）：搜索框 + 五页 + 关于固定底部；宽 < 760 收成 48
             的图标条。全部 code-behind 构建。 -->
        <Border x:Name="NavPane" Grid.Column="0" Margin="12,8,12,12"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

        </Border>

        <!-- 内容列：页面滚动区 + 搜索结果弹层。code-behind 构建。滚动条常驻占道（Visible，
             见 Controls.xaml 滚动条注释）：长短页来回切，页面宽度不跳。 -->
        <Grid x:Name="ContentHost" Grid.Column="1" MinWidth="0">
            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"/>

            <!-- 搜索结果弹层（§6.3）：最多 8 行，带面包屑；Enter 跳转并脉冲。 -->
            <Border x:Name="ResultsHost" Visibility="Collapsed"
                    VerticalAlignment="Top" Margin="0,6,32,0" MaxHeight="360"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Overlay}" Padding="4">
                <StackPanel x:Name="ResultsList"/>
            </Border>
        </Grid>
    </Grid>
</Window>
