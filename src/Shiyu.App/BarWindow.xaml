<Window x:Class="Shiyu.App.BarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Shiyu.App"
        Title="拾语 · 窄条" Width="384" Height="620"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontSize="{DynamicResource Type.Body}"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        Deactivated="OnLostFocus"
        MouseLeftButtonDown="OnBackgroundPressed">
    <!--
      The resident narrow bar (ticket 12): summoned by hotkey, pinned to the
      top of the z-order, dragged by its background, resized by the grip.

      Structure follows the issue 02 spike: pinned cards live in their own
      non-virtualized list STACKED above the scrolling region - visually
      identical to overlaying them, without any scroll synchronization - and
      the main list virtualizes with recycling so ten thousand entries scroll
      on a handful of containers.

      Key-hint badges (ticket 14) sit inside the visuals they explain: hold
      Ctrl and every actionable icon swaps in place for the key that drives
      it. The badge texts and tooltip keys come from Core's KeyMap (§5.2,
      ticket 25); BarKeys answers from the same table.

      共享观感自票 19 起住在 Themes/Controls.xaml（SearchBox/KeyCap/
      IconButton/KindTab）；这里只剩窄条自己的密度档与卡片模板。
    -->
    <Window.Resources>

        <!--
          The tray buttons' look（§6.1 托盘/状态矩阵）；their motion lives in
          code (ActionTray). 命中 32×32、hover 底块 28×28、字形 16；静止
          TextSecondary。危险钮独立一族：静止 Danger、hover 字转 Danger 底叠
          Danger 8%（DangerSubtle），再叠 9%。
        -->
        <Style x:Key="TrayButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="2" Background="{DynamicResource Brush.StateHover}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.StatePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayDangerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="2" Background="{DynamicResource Brush.DangerSubtle}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.StatePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          类型分段（§6.1 第 2 行 / U-05）：4×32 的图标分段，选中 = accent
          字形 + 底部 3×12 accent 指示条，无实心块——"什么都没筛"不再是
          头部最重的一块颜色。字形族与托盘 IconGlyph 同源（票 39）。
        -->
        <Style x:Key="KindSegmentChip" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Hover" Grid.Row="0" CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="2" Background="{DynamicResource Brush.StateHover}" Opacity="0"/>
                            <ContentPresenter Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Indicator" Grid.Row="1" Width="12" Height="3"
                                    CornerRadius="{DynamicResource Radius.Thumb}"
                                    HorizontalAlignment="Center" Background="Transparent"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.StatePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The favourite filter（§6.1 ☆ 32 / Alt+S）：one star that fills with
          the accent when the filter is on — E735 is the same glyph the
          favourite action carries, so "make favourite" and "see favourites"
          agree. 空心星 = 未收藏（只说真话）。
        -->
        <Style x:Key="StarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="2" Background="{DynamicResource Brush.StateHover}" Opacity="0"/>
                            <Grid>
                                <TextBlock x:Name="StarOut" Text="&#xE734;"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           FontSize="{DynamicResource Size.IconS}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StarIn" Text="&#xE735;"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           FontSize="{DynamicResource Size.IconS}"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarOut" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="StarIn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="StarOut" Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.StatePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          标签 ghost 下拉（U-04）：替换 Aero2 ComboBox 的 ghost 钮——字形 +
          当前标签名 + 小箭头，静止透明，hover 才起 5% 底；已筛时整钮 accent
          （UpdateTagFace）。弹层见 OnTagFilterClicked。
        -->
        <Style x:Key="GhostDropdown" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="2" Background="{DynamicResource Brush.StateHover}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.StatePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The resize grip is a hit area, not a face: the default Thumb
             template paints a raised lump that has nothing to do with the
             sheet it sits on. -->
        <Style x:Key="InvisibleGrip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Rows are plain; the card visuals live in the item template.
          栅格对称（§6.1）：主列表右侧有 6 DIP 滚动槽，行右距 2，视觉两侧
          都是 8；置顶列表永不滚动，行距两侧 8。
        -->
        <Style TargetType="{x:Type local:BarCardContainer}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,4,2,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:BarCardContainer}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinnedCardRow" TargetType="{x:Type local:BarCardContainer}"
               BasedOn="{StaticResource {x:Type local:BarCardContainer}}">
            <Setter Property="Margin" Value="8,4"/>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:BarCard}">
            <!--
              卡片（§6.1）：Surface + 1 DIP CardStroke、圆角 4、Padding 12,8。
              四态走叠加层（hover 5% / pressed 9%，StateOverlay，不改底色不占
              布局）；选中 = 2 DIP accent 内环（Ring，独立 Border 叠加，正文
              一像素都不动——选中不再换 BorderThickness）。
            -->
            <Grid MouseLeftButtonDown="OnCardPressed"
                  MouseRightButtonUp="OnCardRightClick"
                  MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave"
                  MouseMove="OnCardMouseMove">
            <local:CardSurface x:Name="Card" CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1"
                    Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Meta（票 39 三段式的上行）: where it came from and what
                         it is on the left — the type badge is icon + word, the
                         same glyph family the facet chips use; on the right the
                         timestamp, which yields its place to the hover actions
                         and takes it back afterwards.
                         纯文本不再自报类型（§6.1）：扫读位留给信息量——链接、
                         "图片 · 1920×1080"、"3 个文件"。 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <!-- 来源图标 18×18（§6.1 卡片）：位图是最快的识别线索；
                             键帽就盖在它上面，同 18 单位。HighQuality + 像素
                             对齐：源是 32px 帧，125%/150% 缩放下缩小渲染，
                             默认 Linear 缩放边缘发糊（2026-10-04 走查）。 -->
                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,6,0"
                              UseLayoutRounding="True">
                            <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"/>
                            <!-- 没有来源图标时的回退：拾语的品牌标志（小号母版，矢量）。 -->
                            <Image Source="{DynamicResource Brand.Mark}"
                                   Visibility="{Binding FallbackIconVisibility}"/>
                            <!-- Covers the icon exactly while Ctrl is held. -->
                            <local:RowKeyBadge Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <local:HandoverText Text="{Binding WhenText}" FontSize="{DynamicResource Type.Caption}"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding WhenToolTip}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip="{Binding KindToolTip}"
                                    Visibility="{Binding KindLabelVisibility}">
                            <TextBlock Text="{Binding KindGlyph}" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconXs}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding KindText}" FontSize="{DynamicResource Type.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Body: text clamped to N lines, images to N units, a
                         colour entry preceded by a swatch of itself. The
                         text clamp is a height of exact line multiples rather
                         than MaxLines, because this build's XAML compiler
                         rejects bindings on MaxLines.

                         卡片不再挂系统 ToolTip（2026-10-05 退役）：其关闭行为
                         两次留下"空壳"实录（清内容不关框/禁用不关已开框）；
                         拖放教学迁至预览面板尾行（PreviewWindow.TeachText），
                         bar.card-tooltips 开关随之改控那一行。 -->
                    <DockPanel Grid.Row="1">
                        <Border DockPanel.Dock="Left" Width="44" Height="22" Margin="0,2,8,2"
                                CornerRadius="{DynamicResource Radius.Thumb}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Background="{Binding SwatchBrush}" Visibility="{Binding SwatchVisibility}"
                                VerticalAlignment="Center"/>
                        <local:EntryBodyText x:Name="TextBody" Text="{Binding Face}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="{Binding TextMaxHeight}"
                                   FontSize="{DynamicResource Type.Content}"
                                   LineHeight="{DynamicResource Line.Content}"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <!-- Padding=1：图贴满时高质量缩放在底缘会采样出一条 1px
                             暗线（视觉走查 2026-10-03），一 DIP 缓冲隔开采样边。 -->
                        <Border x:Name="ImageBody" Height="{Binding ImageHeight}"
                                ClipToBounds="True" Padding="1"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Background="{DynamicResource Brush.SurfaceSubtle}"
                                Visibility="{Binding ImageVisibility}">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <!-- Files: type icon per row, dead paths struck through
                             and faded — a path that is gone says so in the
                             list, not after a paste that produced nothing.
                             A copy made only of pictures previews as one. -->
                        <StackPanel x:Name="FilesBody" Visibility="{Binding FilesVisibility}">
                            <Border Height="{Binding ImageHeight}"
                                    ClipToBounds="True" Padding="1"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Background="{DynamicResource Brush.SurfaceSubtle}"
                                    Visibility="{Binding FilePreviewVisibility}"
                                    Margin="0,0,0,4">
                                <Image Source="{Binding FilePreviewSource}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FileRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- DockPanel 而非水平 StackPanel（视觉走查 2026-10-01）：
                                             StackPanel 里省略号拿不到宽，长文件名把"路径不存在"
                                             推出卡片右缘。文件名占剩余宽，失效标记钉在右端。 -->
                                        <DockPanel Margin="0,1" UseLayoutRounding="True">
                                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   SnapsToDevicePixels="True"/>
                                            <TextBlock x:Name="RowDead" DockPanel.Dock="Right" Text="（路径不存在）"
                                                       FontSize="{DynamicResource Type.Caption}"
                                                       Foreground="{DynamicResource Brush.Danger}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding DeadVisibility}"/>
                                            <TextBlock x:Name="RowName" Text="{Binding Name}"
                                                       FontSize="{DynamicResource Type.Body}"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Dead}" Value="True">
                                                <Setter TargetName="RowName" Property="TextDecorations"
                                                        Value="Strikethrough"/>
                                                <!-- 已失效的路径用次级色表达，不乘透明度（票 18/R6） -->
                                                <Setter TargetName="RowName" Property="Foreground"
                                                        Value="{DynamicResource Brush.TextTertiary}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="{DynamicResource Type.Caption}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="0,2,0,0" Text="{Binding FileTail}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Watermarks: quiet, bottom-right, never in the way.
                         The star is a favourite; it never moves the card.
                         The 译 mark says this entry is Shiyu's own kept
                         translation, not something the user copied. The lock
                         is the protected-corner slot (票 39): shown while
                         delete protection covers this card.
                         垫一块卡面色（2026-10-09）：内容字号调大后，正文最后一行常常一直
                         写到右缘、压在水印底下；垫块遮住字尾、左边留 8 DIP，水印始终读得清。
                         悬停/按下的状态层是兄弟层，盖在整张卡上，垫块随卡面一起变色。
                         没有水印时 StackPanel 宽高为零，垫块也就不在了。 -->
                    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{DynamicResource Brush.Surface}" Padding="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconXs}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   ToolTip="受删除保护：先取消收藏或置顶，或在设置中调整保护"
                                   Visibility="{Binding ProtectionVisibility}"/>
                        <TextBlock Text="译" FontSize="{DynamicResource Type.Caption}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   ToolTip="拾语生成的译文，已关联原文条目"
                                   Visibility="{Binding TranslationVisibility}"/>
                        <TextBlock Text="{Binding GroupBadge}" FontSize="{DynamicResource Type.Caption}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   Margin="4,0,0,0"
                                   Visibility="{Binding GroupBadgeVisibility}"/>
                        <!-- E735：与收藏动作同一字形（§4.6 字符换字形）。 -->
                        <TextBlock Text="&#xE735;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconXs}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Visibility="{Binding FavoriteVisibility}"/>
                        <TextBlock Text="已置顶" FontSize="{DynamicResource Type.Caption}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   Margin="6,0,0,0"
                                   Visibility="{Binding PinnedVisibility}"/>
                    </StackPanel>
                    </Border>
                </Grid>
            </local:CardSurface>

            <!-- 悬停动作托盘（§6.1）：浮在元信息行上的 h32 叠加层，不进布局
                 ——悬停前后卡片高度差 0（U-20）。 -->
            <local:ActionTray/>

            <!-- 四态叠加层与选中内环：CardSurface 的兄弟层，铺在内容之上，
                 不进布局、不推动正文一个像素（§6.1"就地显示，零位移"）。 -->
            <Border x:Name="StateOverlay" Margin="1" CornerRadius="{DynamicResource Radius.Thumb}"
                    Background="Transparent" IsHitTestVisible="False"/>
            <Border x:Name="Ring" Margin="1" CornerRadius="{DynamicResource Radius.Thumb}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilesBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="ImageBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilesBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Files">
                    <Setter TargetName="TextBody" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImageBody" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- hover 5% / pressed 9%（StateHover/StatePressed 令牌即此配比）。 -->
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                    <Setter TargetName="StateOverlay" Property="Background"
                            Value="{DynamicResource Brush.StateHover}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, ElementName=Card}" Value="True">
                    <Setter TargetName="StateOverlay" Property="Background"
                            Value="{DynamicResource Brush.StatePressed}"/>
                </DataTrigger>
                <!-- 选中 = 2 DIP accent 内环；底色与描边一概不变。 -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!--
      The floating Win11 shell (§4.7, ticket 20): a translucent brand tint
      over the DWM Acrylic backdrop (ticket 03's recipe — the material renders
      only on a layered window, which this now is). The shell itself paints
      surface only — no border, no shadow — because DWM owns the rounding
      (Overlay 8, 与 DWM 同心，ADR-0012 §5) and the drop shadow. A system that
      refuses those gets the self-drawn chrome from Backdrop.AttachShell.
      The header and footer draw nothing themselves so the material reads as
      one continuous sheet behind everything.
    -->
    <Border x:Name="Shell" CornerRadius="{DynamicResource Radius.Overlay}"
            Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderThickness="0">
    <DockPanel>
        <!--
          Background dragging hangs off the window alone: a bubbling press
          reaches it from anywhere unhandled. Wiring the same handler onto
          these inner borders as well nests DragMove inside DragMove's own
          modal loop, and the outer loop then waits forever for a mouse-up
          the inner one consumed - the whole dispatcher freezes.
        -->
        <Border x:Name="Header" DockPanel.Dock="Top"
                Padding="8,8,8,4">
            <StackPanel>
                <!--
                  第一行（§6.1 h32）：品牌 24（打开管理窗）· 搜索胶囊 32/16
                  （右端 28 DIP 让给 F 键帽，有查询时描边转 Accent）·
                  保持在最前 32。The brand mark is a palette value (Brand.Mark):
                  light theme carries 拾语, dark carries its dark variant 深语,
                  swapped live with every DynamicResource when the theme changes.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 品牌钮两用（用户需求 2026-10-05）：按住即拖动整扇窄条
                         （HTCAPTION 系统移动循环），松手时窗口没位移的这一次按
                         点击算——打开管理窗。走 Preview：按下要先于 Button 的
                         Click 机制被接管。 -->
                    <Button x:Name="BrandButton" Grid.Column="0" Padding="0" Margin="0,0,8,0"
                            Style="{DynamicResource IconButton}" Cursor="SizeAll"
                            PreviewMouseLeftButtonDown="OnBrandPressed"
                            AutomationProperties.Name="拖动窄条 / 打开管理窗"
                            ToolTip="按住拖动窄条；单击打开管理窗（剪贴板历史与整理）">
                        <Border Width="24" Height="24"
                                CornerRadius="{DynamicResource Radius.Control}" ClipToBounds="True">
                            <Image Source="{DynamicResource Brand.Mark}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Button>
                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" Style="{DynamicResource SearchBox}"
                                 local:InputProps.Placeholder="搜索…"
                                 local:InputProps.RightGutter="28"
                                 TextChanged="OnSearchChanged"/>
                        <!-- F: focus search. -->
                        <ContentControl x:Name="SearchKeyBadge" Style="{DynamicResource KeyCap}"
                                        Content="F"
                                        HorizontalAlignment="Right" Margin="0,0,8,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        IsHitTestVisible="False"/>
                    </Grid>
                    <!--
                      保持在最前：Topmost 开关。字形换非图钉的 E74A（上箭头，
                      "置顶"的中文惯用形，与线框 (^) 一致）——E718 图钉留给
                      卡片的"条目置顶"，一个词不再有两个字形。E74A 经票 39
                      双字体 cmap 探测：Segoe Fluent Icons 与 Segoe MDL2 Assets
                      均含此码位。开=accent，关=次级。
                    -->
                    <Button x:Name="TopmostToggle" Grid.Column="2"
                            Cursor="Hand" Click="OnTopmostToggle"
                            Style="{DynamicResource IconButton}">
                        <TextBlock x:Name="TopmostGlyph" Text="&#xE74A;"
                                   FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}"/>
                    </Button>
                </Grid>
                <!--
                  第二行（§6.1 h32）：类型分段（4×32，accent 字形 + 3×12 底部
                  指示条，无实心块）· 分隔线 · ☆ 只看收藏（Alt+S）· 分隔线 ·
                  标签 ghost 下拉（E8EC + 名称 + E70D，已筛不超过 112、名称
                  MaxWidth 56 省略）· 弹性 · 子类型漏斗 · ✕（仅有筛选时出现）。
                  分组管理（E712）随分组抽屉行走（GroupRow 尾），不再占本行。
                -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <StackPanel Orientation="Horizontal" x:Name="KindChips">
                            <ToggleButton x:Name="KindChipAll" Tag="0"
                                          Style="{StaticResource KindSegmentChip}"
                                          Cursor="Hand" Click="OnKindChipClicked"
                                          AutomationProperties.Name="类型：全部"
                                          ToolTip="全部">
                                <Grid>
                                    <TextBlock Text="&#xE8A9;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="{DynamicResource Size.IconS}"/>
                                    <!-- ←→ 就地替换当前选中类型的字形（§6.1 键帽）：
                                         追加到行尾正是它被裁成横线的原因。
                                         帽上文本与 tooltip 的键来自 KeyMap（构造器）。 -->
                                    <ContentControl x:Name="KindCapAll" Style="{DynamicResource KeyCap}"
                                                    Content="←→" Visibility="Collapsed"
                                                    IsHitTestVisible="False"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="KindChipText" Tag="1"
                                          Style="{StaticResource KindSegmentChip}"
                                          Cursor="Hand" Click="OnKindChipClicked"
                                          AutomationProperties.Name="类型：文本"
                                          ToolTip="只看文本">
                                <Grid>
                                    <TextBlock Text="&#xE8D2;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="{DynamicResource Size.IconS}"/>
                                    <ContentControl x:Name="KindCapText" Style="{DynamicResource KeyCap}"
                                                    Content="←→" Visibility="Collapsed"
                                                    IsHitTestVisible="False"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="KindChipImage" Tag="2"
                                          Style="{StaticResource KindSegmentChip}"
                                          Cursor="Hand" Click="OnKindChipClicked"
                                          AutomationProperties.Name="类型：图片"
                                          ToolTip="只看图片">
                                <Grid>
                                    <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="{DynamicResource Size.IconS}"/>
                                    <ContentControl x:Name="KindCapImage" Style="{DynamicResource KeyCap}"
                                                    Content="←→" Visibility="Collapsed"
                                                    IsHitTestVisible="False"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="KindChipFiles" Tag="3"
                                          Style="{StaticResource KindSegmentChip}"
                                          Cursor="Hand" Click="OnKindChipClicked"
                                          AutomationProperties.Name="类型：文件"
                                          ToolTip="只看文件">
                                <Grid>
                                    <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="{DynamicResource Size.IconS}"/>
                                    <ContentControl x:Name="KindCapFiles" Style="{DynamicResource KeyCap}"
                                                    Content="←→" Visibility="Collapsed"
                                                    IsHitTestVisible="False"/>
                                </Grid>
                            </ToggleButton>
                        </StackPanel>
                        <Border Width="1" Height="16" Margin="8,8" Background="{DynamicResource Brush.Divider}"/>
                        <Grid x:Name="FavoriteHost">
                            <ToggleButton x:Name="FavoriteOnly" Style="{StaticResource StarToggleStyle}"
                                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                                          AutomationProperties.Name="只看收藏"
                                          ToolTip="只看收藏"/>
                            <ContentControl x:Name="FavoriteKeyBadge" Style="{DynamicResource KeyCap}"
                                            Content="Alt+S" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            IsHitTestVisible="False"/>
                        </Grid>
                        <Border Width="1" Height="16" Margin="8,8" Background="{DynamicResource Brush.Divider}"/>
                        <!-- 标签 ghost 下拉（U-04）：替换 Aero2 ComboBox；Tab 循环照旧。
                             按住 Ctrl 时内容整组折起、只留键帽（视觉走查 2026-10-03：
                             帽盖在图标+箭头的复合脚印上会从两侧露出碎片——类型片
                             是"帽替字形"，这里同样让帽替整个内容）。 -->
                        <Grid MaxWidth="112">
                            <Button x:Name="TagFilter" Style="{StaticResource GhostDropdown}"
                                    MinWidth="48" Click="OnTagFilterClicked"
                                    ToolTip="标签筛选">
                                <StackPanel x:Name="TagContent" Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EC;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TagName" Text="" MaxWidth="56"
                                               TextTrimming="CharacterEllipsis" Margin="6,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Tab: cycle the tag filter. -->
                            <ContentControl x:Name="TagKeyBadge" Style="{DynamicResource KeyCap}"
                                            Content="Tab" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                        <Button x:Name="SubtypeButton"
                                Style="{DynamicResource IconButton}" Click="OnSubtypeButtonClicked"
                                AutomationProperties.Name="子类型筛选"
                                ToolTip="按子类型筛选：链接 / 邮箱 / 颜色 / 路径">
                            <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconS}"/>
                        </Button>
                        <!-- ✕ 只在有筛选时出现（§6.1）。 -->
                        <Button x:Name="ClearFilters" Visibility="Collapsed"
                                Style="{DynamicResource IconButton}" Click="OnClearFilters"
                                ToolTip="清除全部筛选">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Size.IconS}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--
          Groups switch, tags filter: the tabs below are drawers (picking one
          shows only its pile), the tag combo above is a label that stacks on
          top of whatever else is asked.
        -->
        <Border x:Name="GroupHostBorder" DockPanel.Dock="Top" Padding="8,0,8,6"
                Visibility="Collapsed">
            <ScrollViewer x:Name="GroupHost" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          SizeChanged="OnGroupHostResized">
                <StackPanel x:Name="GroupRow" Orientation="Horizontal">
                    <ToggleButton x:Name="AllGroupChip" Content="全部" Padding="7,0" Margin="0,0,2,0"
                                  Style="{DynamicResource KindTab}"
                                  Click="OnGroupChipClicked" ToolTip="不看特定分组"/>
                    <ToggleButton x:Name="GroupOverflow" Content="⋯" Width="26"
                                  Style="{DynamicResource KindTab}"
                                  Click="OnGroupOverflowClicked" ToolTip="收起的分组"
                                  Visibility="Collapsed"/>
                    <!--
                      分组管理（E712）随抽屉行走（票 21）：第 2 行按 §6.1 只留
                      类型/收藏/标签/漏斗/✕，分组自己的事归分组行——头部管分组
                      本身，卡片管卡片的归属（票 39 的分工不变）。
                    -->
                        <Button x:Name="GroupMenuButton" Width="26" Height="24" Margin="8,0,0,0"
                                AutomationProperties.Name="分组菜单"
                            Style="{DynamicResource IconButton}" Click="OnGroupMenuClicked"
                            ToolTip="分组：切换抽屉、删除分组、新建分组（头部管分组本身，卡片管卡片的归属）">
                        <TextBlock Text="&#xE712;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="PinnedHost" DockPanel.Dock="Top" Padding="8,6,8,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="置顶" FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="2,0,0,3"/>
                <!--
                  The same container type as the main list: pinned cards need
                  hover trays too, and an ItemsControl's bare presenters never
                  run the tray configuration.
                -->
                <local:BarCardsList x:Name="PinnedList" ItemTemplate="{StaticResource CardTemplate}"
                                    ItemContainerStyle="{StaticResource PinnedCardRow}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,4">
            <Grid>
                <TextBlock x:Name="CountLabel" FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center"/>
                <DockPanel x:Name="FeedbackHost" LastChildFill="False"
                           VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- 家族 ghost 按钮（§6.1 footer / 票 19 组件）：浮层里
                         不放实心主按钮，静止透明、hover 才起底。 -->
                    <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="撤销"
                            Style="{DynamicResource FlyoutButton}"
                            Height="28" MinHeight="28" Padding="10,0"
                            Cursor="Hand" Click="OnUndoDelete"
                            Margin="0,0,24,0"
                            Visibility="Collapsed"
                            ToolTip="恢复刚删除的条目（Ctrl+Z）"/>
                    <TextBlock x:Name="FeedbackLabel" VerticalAlignment="Center"
                               FontSize="{DynamicResource Type.Caption}"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </DockPanel>
                <Thumb x:Name="SizeGrip" HorizontalAlignment="Right" Width="22" Height="14"
                       Cursor="SizeNS" DragDelta="OnGripDrag" Background="Transparent"
                       Style="{StaticResource InvisibleGrip}"/>
            </Grid>
        </Border>

        <!--
          The empty state explains WHY the list is empty — the filter that
          ate everything, or a history that is yet to begin — because "no
          results" reads as breakage exactly when the user needs help most.
        -->
        <Grid>
            <local:BarCardsList x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}"
                                Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.ScrollChanged="OnCardsScrolled"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.CacheLength="1"
                                VirtualizingPanel.CacheLengthUnit="Page"/>

            <!-- 空态底透明（§6.1）：材质是一片连续的板，空态不是板上开洞。 -->
            <Border x:Name="EmptyHost" Visibility="Collapsed"
                    Background="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="300" Margin="16,0">
                <local:EmptyState x:Name="Empty" Glyph="&#xE8A9;">
                    <Button x:Name="EmptyClear" Content="清除筛选"
                            Style="{DynamicResource FlyoutButton}"
                            Height="28" MinHeight="28"
                            HorizontalAlignment="Center"
                            Cursor="Hand" Click="OnClearFilters"
                            Visibility="Collapsed"/>
                </local:EmptyState>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
