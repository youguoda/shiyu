<Window x:Class="Shiyu.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Shiyu.App"
        Title="拾语 · 历史" Width="1100" Height="640" MinWidth="720" MinHeight="480"
        SizeChanged="OnWindowSizeChanged"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        FontSize="{DynamicResource Type.Body}"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
    <!--
      票 24 / ADR-0012 §7：常规窗走系统窗框——SingleBorderWindow 客户区透明
      （code-behind 把 CompositionTarget.BackgroundColor 置透明，票 19 spike
      配方，与票 23 设置窗同款），DWM 在底下画 Mica，标题栏、圆角、阴影、
      贴靠布局都是系统的。旧配方（分层窗口 + 自绘壳 + 自绘 caption）整体
      退役——管理窗不再是悬浮家族的一员。

      栅格（§6.4）：头部 48（SearchBox token 化 + 筛选 + 计数）、命令栏 40
      （取代底部按钮墙）、内容双栏（≥960 时列表 400 + 详情，更窄单栏）。
    -->
    <Window.Resources>
        <!--
          行模板（§6.4 列表）：缩略图 64×48 圆角 4；元信息行 = 相对时间 ·
          来源 · 字数（图片"宽×高"、文件"N 个"，code-behind 组装进 Meta）。
          复选框静止不存在（RowProps.ShowCheck，多选才出现）；置顶/收藏的
          字形只在真有那个状态时出现——字形与状态一致（§6 北极星 3）。
        -->
        <!--
          行骨架必须是 Grid 而不是水平 StackPanel（视觉走查 2026-10-01）：
          StackPanel 沿排列方向给子元素无限宽度，Preview 的省略号永远不
          触发——长标题一路按自然宽排版（实测 2309 DIP），被列缘硬切半个
          字，收藏星被推到两千米外不可见。Grid 的 * 列把宽度收回来。
        -->
        <DataTemplate x:Key="EntryRowTemplate">
            <Grid Margin="2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="RowCheck" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                          Focusable="False" Visibility="Collapsed"
                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <Border Grid.Column="1" Width="64" Height="48" Margin="0,0,10,0"
                        Padding="1"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Background="{DynamicResource Brush.SurfaceSubtle}"
                        Visibility="{Binding ThumbnailVisibility}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Grid Grid.Column="2" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"
                      UseLayoutRounding="True">
                    <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"/>
                    <!-- 没有来源图标时的回退：拾语的品牌标志（小号母版，矢量）。 -->
                    <Image Source="{DynamicResource Brand.Mark}"
                           Visibility="{Binding FallbackIconVisibility}"/>
                </Grid>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <!-- 同理用 DockPanel：置顶字形占 Auto，标题拿剩余宽，省略号才有宽可省。 -->
                    <DockPanel>
                        <TextBlock x:Name="PinGlyph" DockPanel.Dock="Left" Text="&#xE77A;" Margin="0,0,6,0"
                                   FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconXs}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Visibility="{Binding PinVisibility}"/>
                        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource Type.Caption}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StarGlyph" Grid.Column="4" Text="&#xE735;" Margin="10,0,0,0"
                           FontFamily="{DynamicResource Font.Icon}" FontSize="{DynamicResource Size.IconS}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Visibility="{Binding StarVisibility}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Path=(local:RowProps.ShowCheck), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RowCheck" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          命令栏轻量按钮（§6.4）：高 28（Control.HeightCompact），图标 + 文字，
          透明底、hover 状态块。控件族住在 Themes/Controls.xaml；这里只是
          密度与内容形状。按钮的键帽态（按住 Ctrl 原位换 KeyCap）由
          code-behind 换 Content，不动布局。
        -->
        <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource FlyoutButton}">
            <Setter Property="Height" Value="{DynamicResource Control.HeightCompact}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 菜单行 MenuRowButton 已移到 Themes/Controls.xaml（2026-10-09）：翻译面板与反向输入框的
             提示词模板列表也用它。 -->

        <!--
          翻译记录的行（用户需求 2026-10-09）：元信息（时间 · 哪个框 · 模板）、原文（次级色，
          一行）、结果（内容字号，至多三行）。结果是用户回来找的东西，所以它最醒目。
        -->
        <DataTemplate x:Key="LogRowTemplate">
            <StackPanel Margin="2,8,2,8">
                <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding OriginalLine}" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Translated}" Margin="0,2,0,0"
                           FontSize="{DynamicResource Type.Content}"
                           LineHeight="{DynamicResource Line.Content}"
                           LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="{Binding ClampHeight}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!--
      根底 = SurfaceMaterial（票 03 的"材质上叠品牌淡染"配方，视觉走查
      2026-10-03 补上）：这扇窗的裸区此前完全指望 DWM Mica 画底，而材质
      未实际渲染时（TrySet 成功≠视觉生效，实测暗色主题下整片正文透出
      桌面亮底，白字不可读），现在常画一层 94% 不透明的主题淡染——材质
      生效时纹理仍隐约透出，失效时底色兜底，两个主题都可读。
    -->
    <Grid x:Name="RootGrid" ClipToBounds="True"
          Background="{DynamicResource Brush.SurfaceMaterial}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ 头部 48（§6.4）：页签 · 搜索胶囊（内嵌筛选 token）· 筛选弹层 · 计数 ═══ -->
        <Grid Grid.Row="0" Margin="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--
              页签（用户需求 2026-10-09）：剪贴板历史与翻译记录是两本账，各有各的搜索、
              计数、命令栏与列表；同一扇窗里切换，不另开窗。
            -->
            <StackPanel x:Name="PageTabs" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                <ToggleButton x:Name="HistoryTab" Style="{StaticResource KindTab}" Height="32"
                              IsChecked="True" Click="OnHistoryTabClick" Content="剪贴板历史"
                              ToolTip="复制过的内容 · Ctrl+Tab 换页"/>
                <ToggleButton x:Name="LogTab" Style="{StaticResource KindTab}" Height="32"
                              Click="OnLogTabClick" Content="翻译记录"
                              ToolTip="翻译框与反向输入框的每一次翻译 · Ctrl+Tab 换页"/>
            </StackPanel>

            <!--
              搜索胶囊 = SearchBox 观感的复合件：胶囊壳用 SearchBox 同一套
              令牌（SurfaceInput/StrokeStrong/Radius.Pill），内部是图标 +
              token 行 + 无边框输入。token 行由 code-behind 增删；Backspace
              在输入为空时弹掉最后一个 token（§6.4 头部）。
            -->
            <Border x:Name="SearchPill" Grid.Column="1" Height="32"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Background="{DynamicResource Brush.SurfaceInput}"
                    BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1">
                <DockPanel Margin="12,0,12,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{DynamicResource Size.IconS}"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               IsHitTestVisible="False"/>
                    <StackPanel x:Name="TokenHost" DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Padding="0" MinWidth="60"
                             Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center"
                             local:InputProps.Placeholder="搜索历史…"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchBoxKeyDown"/>
                </DockPanel>
            </Border>

            <Button x:Name="FilterButton" Grid.Column="2" Style="{StaticResource CommandButton}"
                    Margin="8,0,0,0" Click="OnFilterButtonClick" ToolTip="筛选：类型 / 日期 / 子类型 / 标签">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                    <TextBlock Text="筛选" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 等宽数字：计数不随数字宽度跳动（§6.4 头部）。 -->
            <TextBlock x:Name="CountLabel" Grid.Column="3" Margin="12,0,2,0" MinWidth="72"
                       TextAlignment="Right" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>

            <!-- 翻译记录页的头部：同一套搜索胶囊（没有筛选 token——一张表、两段文字）与计数。 -->
            <Border x:Name="LogSearchPill" Grid.Column="1" Grid.ColumnSpan="2" Height="32"
                    Visibility="Collapsed"
                    CornerRadius="{DynamicResource Radius.Pill}"
                    Background="{DynamicResource Brush.SurfaceInput}"
                    BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1">
                <DockPanel Margin="12,0,12,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{DynamicResource Size.IconS}"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="LogSearchBox" Padding="0" MinWidth="60"
                             Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center"
                             local:InputProps.Placeholder="搜索原文或译文…"
                             TextChanged="OnLogSearchTextChanged"/>
                </DockPanel>
            </Border>
            <TextBlock x:Name="LogCountLabel" Grid.Column="3" Margin="12,0,2,0" MinWidth="72"
                       Visibility="Collapsed"
                       TextAlignment="Right" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
        </Grid>

        <!-- ═══ 命令栏 40（§6.4）：左动作组 · 删除 · 右 ⋯ ═══ -->
        <DockPanel x:Name="HistoryCommands" Grid.Row="1" Margin="16,6,16,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="CopyButton" Style="{StaticResource CommandButton}" Click="OnCopySelected"
                        ToolTip="复制到剪贴板 · Enter&#10;管理窗没有粘贴目标，Enter 是复制">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                        <TextBlock Text="复制" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PinButton" Style="{StaticResource CommandButton}" Click="OnTogglePin"
                        ToolTip="置顶 / 取消置顶 · P">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PinGlyphIcon" Text="&#xE718;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PinLabel" Text="置顶" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FavoriteButton" Style="{StaticResource CommandButton}" Click="OnToggleFavorite"
                        ToolTip="收藏 / 取消收藏 · S">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FavoriteGlyph" Text="&#xE734;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                        <TextBlock Text="收藏" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TagButton" Style="{StaticResource CommandButton}" Click="OnTagButtonClick"
                        ToolTip="标签 · T">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                        <TextBlock Text="标签" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconXs}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="16" Margin="10,0,8,0" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Divider}"/>

                <!-- 删除：只有图标（§6.4）——动词已经在颜色和 tooltip 里。 -->
                <Button x:Name="DeleteButton" Style="{StaticResource CommandButton}" Width="36" Padding="0"
                        Click="OnDeleteSelected" ToolTip="删除 · D">
                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{DynamicResource Size.IconS}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource CommandButton}"
                    Margin="0" Width="36" Padding="0" Click="OnMoreButtonClick" ToolTip="更多操作">
                <TextBlock Text="&#xE712;" FontFamily="{DynamicResource Font.Icon}"
                           FontSize="{DynamicResource Size.IconS}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>
        </DockPanel>

        <!-- 翻译记录页的命令栏：复制译文 · 复制原文 · 删除 · 右侧清空全部（不可撤销，走确认）。 -->
        <DockPanel x:Name="LogCommands" Grid.Row="1" Margin="16,6,16,0" LastChildFill="False"
                   Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="LogCopyButton" Style="{StaticResource CommandButton}" Click="OnLogCopyTranslation"
                        ToolTip="复制译文 · Enter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                        <TextBlock Text="复制译文" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LogCopyOriginalButton" Style="{StaticResource CommandButton}"
                        Click="OnLogCopyOriginal" ToolTip="复制原文 · O">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                        <TextBlock Text="复制原文" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="16" Margin="10,0,8,0" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Divider}"/>

                <Button x:Name="LogDeleteButton" Style="{StaticResource CommandButton}" Width="36" Padding="0"
                        Click="OnLogDelete" ToolTip="删除 · D">
                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{DynamicResource Size.IconS}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <Button x:Name="LogClearButton" DockPanel.Dock="Right" Style="{StaticResource CommandButton}"
                    Margin="0" Click="OnLogClearAll" ToolTip="删除全部翻译记录（剪贴板历史不受影响）">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE894;" FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{DynamicResource Size.IconS}" VerticalAlignment="Center"/>
                    <TextBlock Text="清空全部" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- 翻译记录页的内容：列表与空态；撤销条在切页时搬过来（同一个 ToastHost）。 -->
        <Grid x:Name="LogContent" Grid.Row="2" Margin="16,8,16,12" Visibility="Collapsed">
            <ListBox x:Name="LogList" SelectionMode="Extended"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ItemTemplate="{StaticResource LogRowTemplate}"
                     MouseDoubleClick="OnLogDoubleClick"
                     SelectionChanged="OnLogSelectionChanged"/>
            <local:EmptyState x:Name="LogEmpty" Glyph="&#xE81C;" Visibility="Collapsed"
                              VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="24,0,24,0"/>
        </Grid>

        <!-- ═══ 内容（§6.4）：InfoBar · 列表 | 详情 · 全屏预览浮层 ═══ -->
        <Grid x:Name="HistoryContent" Grid.Row="2" Margin="16,8,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 错误反馈住详情栏顶部（§6.4 反馈）；跨全宽，窄窗也看得见。
                 默认收起（InfoBar 的 IsOpen 默认 true，空条不出场）。 -->
            <local:InfoBar x:Name="DetailNotice" Grid.Row="0" Margin="0,0,0,8" IsOpen="False"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="*"/>
                    <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- 列表侧：滚动列表 + 吸顶分组头（浮层）+ 撤销条（浮层） -->
                <Grid x:Name="ListSide" Grid.Column="0">
                    <!-- 列表、详情、翻译记录的滚动条都常驻占道（Visible，见 Controls.xaml
                         滚动条注释）：筛选让列表变长变短，行宽不跳。 -->
                    <local:LibraryList x:Name="EntryList"
                                       Style="{DynamicResource BareList}"
                                       SelectionMode="Extended"
                                       HorizontalContentAlignment="Stretch"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                       ScrollViewer.VerticalScrollBarVisibility="Visible"
                                       VirtualizingPanel.IsVirtualizing="True"
                                       VirtualizingPanel.VirtualizationMode="Recycling"
                                       ItemTemplate="{StaticResource EntryRowTemplate}"
                                       MouseDoubleClick="OnListDoubleClick"
                                       PreviewMouseMove="OnListMouseMove"
                                       SelectionChanged="OnSelectionChanged"/>

                    <!-- 吸顶分组头（§6.4 列表）：与分组头同款视觉，浮在列表上缘；
                         右侧让出滚动条槽。 -->
                    <Border x:Name="StickyHeader" VerticalAlignment="Top" Height="28"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                            Visibility="Collapsed" IsHitTestVisible="False" Margin="1,0,14,0">
                        <DockPanel Margin="8,0,8,0" LastChildFill="False">
                            <TextBlock x:Name="StickyTitle" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Type.Caption}"
                                       FontWeight="{DynamicResource Weight.Emphasis}"/>
                        </DockPanel>
                    </Border>

                    <!--
                      撤销条（§6.4 反馈）：浮在列表左下，40 高，5 秒进度线，
                      悬停暂停；轻反馈 1.5 秒无进度线。取代被按钮墙盖住的
                      StatusLabel。
                    -->
                    <Border x:Name="ToastHost" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="1,0,1,6" Height="40" MinWidth="220" MaxWidth="420"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Visibility="Collapsed" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="12,0,8,0" LastChildFill="False">
                                <Button x:Name="ToastUndoButton" DockPanel.Dock="Right" Height="24"
                                        Padding="12,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource FlyoutButton}" Cursor="Hand"
                                        Click="OnUndoDelete" Content="撤销"/>
                                <TextBlock x:Name="ToastText" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Border x:Name="ToastProgress" Grid.Row="1" Height="2"
                                    HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource Brush.Accent}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 详情侧：三态（空态 / 单选 / 多选批量）+ Agent 结果区。 -->
                <Grid x:Name="DetailPane" Grid.Column="1" Margin="16,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Visible">
                        <StackPanel x:Name="DetailBody" Margin="4,0,4,0"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!--
              全屏预览（§6.4 窗口）：按住 Space 打开，松开即关；Esc 也关。
              单栏窄窗下它是"看全文"的唯一途径。
            -->
            <Border x:Name="PreviewLayer" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Background}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="36" BorderBrush="{DynamicResource Brush.Divider}"
                            BorderThickness="0,0,0,1">
                        <TextBlock x:Name="PreviewHint" Margin="16,0,16,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Type.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="松开 Space 关闭 · Esc"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PreviewBody" Margin="24,16,24,24"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
