<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shiyu.Core\Shiyu.Core.csproj" />
    <ProjectReference Include="..\Shiyu.Windows\Shiyu.Windows.csproj" />
  </ItemGroup>

  <!-- The brand marks ride as loose resources so ThemeManager can address
       them by pack URI and swap them with the palette (ticket 39). -->
  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <!-- 离线英汉词典（评审 2026-10-16 F-08）：ECDICT 常用词子集，约 4.2 万词，只读，随程序发布到
       安装目录的 Assets 下。来源、许可与重新生成见 tools/dictionary/README.md；第三方声明一起带上。 -->
  <ItemGroup>
    <None Include="Assets\dictionary.db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The about page's 拾 mark as the exe/window/taskbar icon (user
         request 2026-10-04). Nine PNG-in-ICO frames, 16..256. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
