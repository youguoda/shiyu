<Window x:Class="Shiyu.App.PreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾语 · 预览" Width="360" Height="240"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        FontSize="{DynamicResource Type.Body}"
        TextElement.FontFamily="{DynamicResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <!--
      The full-content preview (ticket 17). Round, translucent over the theme's
      own surface colour (set in code so theme switches reach it), blurred by
      the system material (DwmEffects, on the handle), and never activated:
      reading it costs the user nothing, not even their caret.

      The size is decided before anything is shown, from numbers the database
      already has, so the window opens at the size it keeps. Content that
      outgrows the box scrolls; the box never moves.
    -->
    <!--
      外壳（§4.7，票 20）：只画 SurfaceMaterial 材质底；圆角 8、轮廓与
      投影归 DWM（DwmEffects 在句柄上设，拒收时 OnSourceInitialized 落
      Backdrop.DegradeShell 的自绘描边+阴影与 12 DIP 透明边距）。
      与卡片之间不画连接（用户需求 2026-10-05 删去连接线与同色桥）：
      面板紧挨窄条、顶与行对齐，位置本身就说明它属于哪一行。
    -->
    <!-- UseLayoutRounding：图片落在整屏幕像素上——原图按屏幕像素解码，再被半个像素的偏移
         双线性一抹，又糊了（用户实录 2026-10-09）。文字的尺寸算术留有 2 DIP 余量，取整不会多折一行。 -->
    <Border x:Name="Root" CornerRadius="{DynamicResource Radius.Overlay}"
            Background="{DynamicResource Brush.SurfaceMaterial}"
            BorderThickness="0"
            Padding="12,10"
            UseLayoutRounding="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Name="WhenText" DockPanel.Dock="Right"
                           FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="KindText" FontSize="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="TextHost" Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- 预览正文：被阅读的内容，Type.Content 18/31（ADR-0012 排版 2）；
                         Measure() 用同一对常量算尺寸。 -->
                    <TextBlock x:Name="TextBody" TextWrapping="Wrap"
                               FontSize="{DynamicResource Type.Content}"
                               LineHeight="{DynamicResource Line.Content}"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Brush.Text}"/>
                </ScrollViewer>

                <!-- 显示框（MaxWidth/MaxHeight）由 Fill 按屏幕像素定，缩略图与原图画进同一个框。 -->
                <Image x:Name="ImageHost" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <ScrollViewer x:Name="FilesHost" Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FilesBody"/>
                </ScrollViewer>
            </Grid>

            <!-- 教学行（2026-10-05 从卡片气泡迁来）：系统 ToolTip 的关闭
                 行为留过两次"空壳"实录，气泡整体退役；拖放教学常驻预览
                 尾行，看得更久，bar.card-tooltips 关闭时整行隐藏。
                 同日改版（用户需求：更匹配这个应用的 UI）：一整句灰字换成
                 一行键帽 + 短动作（PreviewTeaching），帽用 KeyCap.Quiet；
                 一行放得下由 Measure 保证，行高是常量 TeachRowHeight。 -->
            <Border x:Name="TeachHost" Grid.Row="2" Margin="0,10,0,0"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0"
                    Padding="0,8,0,0" Visibility="Collapsed">
                <ItemsControl x:Name="TeachRow" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <ContentControl Style="{StaticResource KeyCap.Quiet}" Content="{Binding Key}"/>
                                <TextBlock Text="{Binding Action}" Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Type.Caption}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</Window>
